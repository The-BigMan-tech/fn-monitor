{
    "name": "@typescript-guy/fn-monitor",
    "version": "1.9.0",
    "description": "An instrumentation layer over a JS-in-JS interpreter to monitor, intercept, and mutate a function's execution at the AST level.",
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist/**/*.js",
        "dist/**/*.d.ts",
        "logo.svg",
        "LICENSE.md",
        "README.md",
        "ACKNOWLEDGEMENTS.md",
        "CHANGELOG.md",
        "BRANDING.md"
    ],
    "author": {
        "name": "typescript-guy",
        "url": "https://github.com/The-BigMan-tech"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/The-BigMan-tech/fn-monitor.git"
    },
    "keywords": [
        "javascript",
        "typescript",
        "sval",
        "ast",
        "ast-walker",
        "function-monitor",
        "interpreter",
        "monitor",
        "monitoring-tool",
        "debugging",
        "debugging-tool",
        "metaprogramming",
        "execution-control",
        "runtime",
        "sandbox",
        "hooks",
        "function-inspection",
        "runtime-analysis",
        "timeout",
        "instrumentation"
    ],
    "scripts": {
        "build": "vite build",
        "test": "vitest run",
        "test:interpreter": "vitest run ./tests/interpreter",
        "test:modifications": "vitest run ./tests/modifications",
        "prepublishOnly": "npm run test && npm run build",
        "publish:public": "npm publish --registry=https://registry.npmjs.org/ --access public",
        "write-changelog": "tsx ./scripts/write-changelog.ts",
        "lint:fix":"eslint . --fix"
    },
    "dependencies": {
        "@types/estree": "^1.0.8",
        "acorn": "^8.14.0",
        "ansis": "^4.3.1",
        "astring": "^1.9.0",
        "js-sha256": "^1.0.0",
        "lru-cache": "^11.3.5",
        "meriyah": "^7.3.2"
    },
    "devDependencies": {
        "@stylistic/eslint-plugin": "^5.10.0",
        "@types/node": "^22.15.3",
        "@vitest/coverage-v8": "^3.1.2",
        "changelogen": "^0.6.2",
        "eslint": "^10.9.1",
        "happy-dom": "^20.0.11",
        "rollup": "^4.62.2",
        "rollup-plugin-dts": "^6.4.1",
        "tsx": "^4.23.1",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.69.0",
        "unplugin-dts": "^1.0.3",
        "vite": "^6.3.4",
        "vitest": "^3.1.2"
    }
}
